{
  "name": "billsbridge",
  "version": "1.0.0",
  "description": "Local bridge for Verifone integration - Gridbase Bills",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "npx pkg . --targets node18-win-x64,node18-macos-x64,node18-macos-arm64 --out-path dist",
    "build:win": "npx pkg . --targets node18-win-x64 --output dist/billsbridge-win.exe",
    "build:mac": "npx pkg . --targets node18-macos-x64,node18-macos-arm64 --out-path dist"
  },
  "pkg": {
    "assets": []
  },
  "dependencies": {}
}
